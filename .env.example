# Copia este archivo a `.env.local` (o define las variables en Vercel/Netlify)
# para activar la sincronización en tiempo real móvil ↔ TV con Firestore.
# Sin estas variables la app funciona en modo local (LocalStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
